# Copy this file to backend/.env for local development.
# On Render/Railway/Heroku, set these in the dashboard instead.
PORT=5000
MONGO_URL=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/smart_expense_tracker?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
NODE_ENV=production
